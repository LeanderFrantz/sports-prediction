# Required
ODDS_API_KEY=your_odds_api_key_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_IDS=your_chat_id_here

# Optional (defaults shown)
EV_THRESHOLD=1.0
SPORTS=football
KELLY_FRACTION=0.25
MAX_BETS=25
MAX_FAIR_ODDS=5.0

# Bookmakers to favour when a bet ties across books, most preferred first.
# These are The Odds API bookmaker keys, not display titles: tipico_de, not
# Tipico. Unset keeps the in-code default.
PREFERRED_BOOKMAKERS=tipico_de,winamax_de

# The Odds API bills (markets x regions), so the four regions below cost 4
# credits per league -- about 52 for a full football scan. Narrowing to the
# regions whose books you can actually bet with cuts that proportionally.
ODDS_REGIONS=eu,uk,us,au

# Alternatively name bookmakers explicitly: this replaces ODDS_REGIONS and is
# billed as a single region (about 13 credits per football scan), but returns
# only the books you list. Pinnacle is added automatically if omitted.
# ODDS_BOOKMAKERS=pinnacle,tipico_de,winamax_de
